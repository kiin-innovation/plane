# Plane Docker Compose — copy to .env and adjust as needed:
#   cp .env.example .env

# Release / images
APP_RELEASE=v1.3.1

# Public URLs (keep in sync with LISTEN_HTTP_PORT)
WEB_URL=http://localhost:3003
CORS_ALLOWED_ORIGINS=http://localhost:3003
APP_DOMAIN=localhost:3003
LISTEN_HTTP_PORT=3003
LISTEN_HTTPS_PORT=443

# Proxy (Caddy)
SITE_ADDRESS=:80
TRUSTED_PROXIES=private_ranges
FILE_SIZE_LIMIT=5242880

# App
DEBUG=0
GUNICORN_WORKERS=1
SECRET_KEY=dev-only-change-me
LIVE_SERVER_SECRET_KEY=dev-only-change-me
API_KEY_RATE_LIMIT=60/minute
USE_MINIO=1
MINIO_ENDPOINT_SSL=0
WEBHOOK_ALLOWED_IPS=
WEBHOOK_ALLOWED_HOSTS=
SKIP_ENV_VAR=0

# Database
PGHOST=plane-db
PGDATABASE=plane
POSTGRES_USER=plane
POSTGRES_PASSWORD=plane
POSTGRES_DB=plane
POSTGRES_PORT=5432
POSTGRES_EXTERNAL_PORT=15432
PGDATA=/var/lib/postgresql/data
DATABASE_URL=postgresql://plane:plane@plane-db/plane

# Redis
REDIS_HOST=plane-redis
REDIS_PORT=6379
REDIS_URL=redis://plane-redis:6379/

# RabbitMQ
RABBITMQ_HOST=plane-mq
RABBITMQ_PORT=5672
RABBITMQ_USER=plane
RABBITMQ_PASSWORD=plane
RABBITMQ_VHOST=plane
AMQP_URL=amqp://plane:plane@plane-mq:5672/plane

# Live server
API_BASE_URL=http://plane-api:8000

# Object storage (MinIO)
AWS_REGION=
AWS_ACCESS_KEY_ID=access-key
AWS_SECRET_ACCESS_KEY=secret-key
AWS_S3_ENDPOINT_URL=http://plane-minio:9000
AWS_S3_BUCKET_NAME=uploads

# SMTP (Mailpit for local email testing)
MAILPIT_UI_PORT=8025
MP_SMTP_BIND_ADDR=0.0.0.0:1025
MP_UI_BIND_ADDR=0.0.0.0:8025
ENABLE_SMTP=1
EMAIL_HOST=plane-mailpit
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_FROM=Plane Dev <dev@localhost>
EMAIL_USE_TLS=0
EMAIL_USE_SSL=0

# SSL / certificates (production)
CERT_ACME_CA=https://acme-v02.api.letsencrypt.org/directory
CERT_EMAIL=
CERT_ACME_DNS=

# Deprecated / unused locally
DOCKERIZED=1
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=sk-
GPT_ENGINE=gpt-3.5-turbo
